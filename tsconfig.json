{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules", "./node_modules/.bun/node_modules/@types"],
    "types": ["bun-types", "node"],
    "paths": {
      "@e2e/shared": ["./packages/shared/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*", "packages/*/test/**/*"]
}
